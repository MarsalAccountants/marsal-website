---
import "../../styles/components/footer.css";
import RegionSwitcher from "../../../shared/market-routing/RegionSwitcher.astro";
import { US_ORIGIN } from "../../../shared/market-routing/config";
import { MAP_EMBED_URL, SOCIAL_LINKS } from "../data/site-config";
---

<footer class="marsal-footer">
    <div class="footer-top">
        <div class="container">
            <div class="footer-grid">

                <!-- QUICK LINKS -->
                <div class="footer-col">
                    <h3>Quick Links</h3>
                    <div class="footer-divider"></div>
                    <ul class="footer-links">
                        <li><a href="/">Home</a></li>
                        <li><a href="/company-profiles/">Company Profile</a></li>
                        <li><a href="/services/">Our Services</a></li>
                        <li><a href="/resources/our-fee/">Our Fees</a></li>
                        <li><a href="/resources/tax-tables/">Tax Tables</a></li>
                        <li><a href="/forms/">Forms</a></li>
                        <li><a href="/articles/?category=Paisley">Accountants in Paisley</a></li>
                        <li><a href="/contact/">Contact Us</a></li>
                        <li><a href="/client-membership-terms-and-conditions/">Terms and Conditions</a></li>
                    </ul>
                </div>

                <!-- OUR SERVICES -->
                <div class="footer-col">
                    <h3>Our Services</h3>
                    <div class="footer-divider"></div>
                    <ul class="footer-links">
                        <li><a href="/services/accounting/">Accounting Services</a></li>
                        <li><a href="/services/bookkeeping/">Bookkeeping Services</a></li>
                        <li><a href="/services/management-accounts/">Management Accounts Services</a></li>
                        <li><a href="/services/payroll/">Payroll Services</a></li>
                        <li><a href="/services/property-accounts/">Property Accounts Services</a></li>
                        <li><a href="/services/self-assessment-tax-returns/">Self Assessment & Tax Returns</a></li>
                        <li><a href="/services/marsal-business-launchpad/">Marsal Business Launchpad</a></li>
                        <li><a href="/services/tax-investigation/">Tax Investigation</a></li>
                        <li><a href="/services/vat/">Value Added Tax Services</a></li>
                    </ul>
                </div>

                <!-- CONTACT -->
                <div class="footer-col">
                    <h3>Reach Us At</h3>
                    <div class="footer-divider"></div>
                    <div class="footer-contact">
                        Office 1.4<br>
                        1 Macdowall Street,<br>
                        Paisley,<br>
                        Scotland,<br>
                        PA3 2NB,<br><br>

                        <div class="footer-contact-line">
                            <i class="fa fa-phone"></i>
                            <a href="tel:+447468641272">07468 641272</a>
                        </div>

                        <div class="footer-contact-line">
                            <i class="fa fa-envelope"></i>
                            <a href="mailto:info@marsalaccountants.co.uk">info@marsalaccountants.co.uk</a>
                        </div>

                        <div class="footer-social">
                            <a href={SOCIAL_LINKS.googleBusiness} target="_blank" rel="noopener noreferrer" aria-label="Find us on Google">
                                <i class="fab fa-google"></i>
                            </a>
                            <a href={SOCIAL_LINKS.facebook} target="_blank" rel="noopener noreferrer" aria-label="Facebook">
                                <i class="fab fa-facebook-f"></i>
                            </a>
                            <a href={SOCIAL_LINKS.twitter} target="_blank" rel="noopener noreferrer" aria-label="X (Twitter)">
                                <i class="fab fa-twitter"></i>
                            </a>
                        </div>
                    </div>
                </div>

                <!-- MAP -->
                <div class="footer-col">
                    <h3>Map</h3>
                    <div class="footer-divider"></div>
                    <div class="footer-map">
                        <iframe
                            src={MAP_EMBED_URL}
                            width="100%" height="250" style="border:0;" allowfullscreen="" loading="lazy"
                            referrerpolicy="no-referrer-when-downgrade"
                            title="Marsal Accountants office location, Paisley"></iframe>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <div class="footer-bottom">
        <div class="container">
            <div class="footer-bottom-grid">
                <div class="footer-bottom-left">
                    <RegionSwitcher currentMarket="uk" class="footer-region-switcher" menuPlacement="above" />
                    <a href={US_ORIGIN} rel="alternate">United States website</a>
                    <span class="footer-divider-vertical"></span>
                    <a href="/privacy-policy/">Privacy Policy</a>
                    <span class="footer-divider-vertical"></span>
                    <a href="/gdpr-compliances/">GDPR Compliance</a>
                    <span class="footer-divider-vertical"></span>
                    <a href="#" data-cookie-settings>Cookie settings</a>
                    <span class="footer-divider-vertical"></span>
                    <a href="/accountants-central-scotland/">Accountants – Central Scotland</a>

                    <p class="footer-copyright">
                        Copyright © 2025, Marsal Accountants Ltd<br>
                        Company Registration Number: SC848515 | Company registered at Companies House, Scotland
                    </p>
                </div>

                <div class="footer-bottom-right">
                    <img src="/images/gdpr.png"
                         alt="GDPR compliance" class="footer-gdpr">
                </div>
            </div>
        </div>
    </div>
</footer>

<style>
  .footer-region-switcher {
    display: block;
    margin-bottom: 1rem;
  }
</style>
