---
import "../../styles/components/cookie-banner.css";
---

<div id="cookie-banner" class="cookie-banner cookie-banner--hidden" role="dialog" aria-label="Cookie consent" aria-live="polite">
  <div class="cookie-banner__inner">
    <p class="cookie-banner__text">
      We use essential cookies to run this site and optional analytics cookies to understand how visitors use it.
      See our <a href="/privacy-policy/">Privacy Policy</a> for details.
    </p>
    <div class="cookie-banner__actions">
      <button type="button" id="cookie-accept" class="cookie-banner__btn cookie-banner__btn--accept">
        Accept
      </button>
      <button type="button" id="cookie-reject" class="cookie-banner__btn cookie-banner__btn--reject">
        Reject non-essential
      </button>
    </div>
  </div>
</div>
