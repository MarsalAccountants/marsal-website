---
import "../../styles/pages/company-profiles.css";
import Layout from "../layouts/BaseLayout.astro";
import ContactUs from "../components/ContactUs.astro";
import { US_ORIGIN, US_PRACTICE_PUBLIC_LABEL } from "../../../shared/market-routing/config";

const team = [
  {
    name: "Shahzad Hussain",
    role: "Practice Director",
    image: "/images/marsal-accountants-director.PNG",
    alt: "Shahzad Hussain, Practice Director at Marsal Accountants",
    bio: "As a Director at Marsal Accountants, I am committed to high standards, transparent communication, and meaningful client partnerships. I guide our service quality, technical direction, and the strategic evolution of the firm.",
  },
  {
    name: "Amna Talib",
    role: "Client Accounts Manager",
    image: "/images/amna-talib-client-accounts-manager.png",
    alt: "Amna Talib, Client Accounts Manager at Marsal Accountants",
    bio: "As a Client Accounts Manager at Marsal Accountants, I am committed to clear communication, timely responses, and dependable day-to-day support. I manage client enquiries, documentation, and deadlines, and serve as your consistent point of contact throughout the year.",
  },
];
---

<Layout title="About Us | Accountants in Paisley | Marsal Accountants" description="Marsal Accountants in Paisley — our philosophy, leadership, and team supporting businesses across Scotland.">
  <main class="about-page">

    <section class="about-section">
      <h1 class="about-heading">Our Philosophy</h1>
      <div class="about-divider"></div>

      <p class="about-lead">
        At <span class="mg">Marsal Accountants</span>, our philosophy is straightforward:
        to provide every client with clarity, confidence, and attentive care across all accounting and tax matters.
      </p>

      <div class="about-text philosophy-text director-vision">
        <h2 class="about-subheading">Director&rsquo;s Vision</h2>
        <p>
          My vision for <span class="mg">Marsal</span> has always been to build a practice that combines modern capability
          with personal accountability. Accounting should not feel distant or overly complex &mdash; it should feel like
          a trusted partnership.
        </p>
        <p>
          We work with business owners and individuals across Paisley, Glasgow, and Scotland who expect advisers that
          understand their circumstances, communicate clearly, and deliver with precision.
        </p>
        <p>
          Every return we submit and every set of accounts we prepare is guided by one principle:
          <strong>your success is our responsibility.</strong>
        </p>
      </div>

      <div class="team-section">
        <h2 class="about-subheading team-heading">Our Team</h2>
        <p class="team-intro">
          A focused team combining strategic leadership with dedicated client support.
        </p>
        <div class="team-grid">
          {team.map((member) => (
            <article class="team-card">
              <div class="team-card-photo">
                <img
                  src={member.image}
                  alt={member.alt}
                  class="team-card-image"
                  loading="lazy"
                />
              </div>
              <div class="team-card-body">
                <h3 class="team-card-name">{member.name}</h3>
                <p class="team-card-role">{member.role}</p>
                <p class="team-card-bio">{member.bio}</p>
              </div>
            </article>
          ))}
        </div>
      </div>

      <div class="values-grid">
        <div class="value-card">
          <div class="value-icon"><i class="fas fa-lightbulb"></i></div>
          <h3 class="value-title">Clarity Above Everything</h3>
          <p class="value-text">
            We explain your accounts and tax position in simple, direct language — so you always know where you stand.
          </p>
        </div>
        <div class="value-card">
          <div class="value-icon"><i class="fas fa-check-circle"></i></div>
          <h3 class="value-title">Precision You Can Trust</h3>
          <p class="value-text">
            Every figure, return, and deadline is handled with accuracy, discipline, and professional care.
          </p>
        </div>
        <div class="value-card">
          <div class="value-icon"><i class="fas fa-gears"></i></div>
          <h3 class="value-title">Modern Systems, Human Support</h3>
          <p class="value-text">
            We use efficient digital resources, but our service is always personal, accessible, and built around real relationships.
          </p>
        </div>
      </div>
    </section>

    <section class="about-section">
      <h1 class="about-heading">Company Profile</h1>
      <div class="about-divider"></div>

      <p class="about-lead">
        With over eight years of experience and a modern, client‑first approach,
        <strong><span class="mg">Marsal Accountants</span></strong> provides tailored accounting and tax solutions
        to businesses and individuals across the UK.
      </p>

      <div class="company-profile-content">
        <div class="profile-text-above">
          <p>
            We specialise in Business Accounts, Tax Returns, VAT, Payroll, Bookkeeping, and advisory services
            for Sole Traders, Partnerships, LLPs, Limited Companies, and PLCs.
          </p>
        </div>
        <div class="profile-image-center">
          <img
            src="/images/marsal-accountants-about-us.png"
            alt="Marsal Accountants About Us"
            class="profile-center-image"
            loading="lazy"
          />
          <div class="about-caption">Supporting clients across Scotland</div>
        </div>
        <div class="profile-strength-clients">
          <div class="strength-clients-grid">
            <div class="strength-section">
              <h2 class="about-subheading">Our Strength</h2>
              <p>
                Our strength lies in strategic insight, attention to detail, and meaningful client relationships.
                We help businesses stay compliant, understand their numbers, and plan with confidence.
              </p>
            </div>
            <div class="clients-section">
              <h2 class="about-subheading">Who We Serve</h2>
              <div class="clients-box">
                <h3>Our Clients Range From:</h3>
                <div class="clients-list">
                  <div class="client-item">
                    <div class="client-checkmark"><i class="fas fa-check"></i></div>
                    <div class="client-text">Doctors, Dentists, Solicitors to Opticians, Pharmacies, and Estate Agencies</div>
                  </div>
                  <div class="client-item">
                    <div class="client-checkmark"><i class="fas fa-check"></i></div>
                    <div class="client-text">Hotels, Pubs, Restaurants to Subways, Papa Johns, and Cafés</div>
                  </div>
                  <div class="client-item">
                    <div class="client-checkmark"><i class="fas fa-check"></i></div>
                    <div class="client-text">Supermarkets, Convenience Stores, Office licenses to Furniture and Mobile Phone retailers</div>
                  </div>
                  <div class="client-item">
                    <div class="client-checkmark"><i class="fas fa-check"></i></div>
                    <div class="client-text">Retailers, Wholesalers, Importers, Exporters, Distributors, and Logistics companies</div>
                  </div>
                  <div class="client-item">
                    <div class="client-checkmark"><i class="fas fa-check"></i></div>
                    <div class="client-text">Electricians, Plumbers, Carpenters to Management Consultants and IT Professionals</div>
                  </div>
                  <div class="client-item">
                    <div class="client-checkmark"><i class="fas fa-check"></i></div>
                    <div class="client-text">Travel Agents, Residential Homes, Hair Salons, Launderettes, and Charities</div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="about-section" id="international-presence">
      <h2 class="about-heading">International presence</h2>
      <div class="about-divider"></div>
      <div class="about-text">
        <p>
          <strong><span class="mg">Marsal Accountants Ltd</span></strong> (company number SC848515) is our United Kingdom practice,
          based in Paisley, Scotland. We provide UK accounting, tax, payroll, and advisory services under UK law.
        </p>
        <p>
          Our <strong>{US_PRACTICE_PUBLIC_LABEL}</strong> supports clients who need United States accounting and tax services.
          UK and US operations are separate; each office handles work in its own jurisdiction. If you need support in both countries,
          we will connect you with the appropriate team.
        </p>
        <p>
          <a href={US_ORIGIN} rel="alternate">Visit our United States website →</a>
        </p>
      </div>
    </section>

    <ContactUs />
  </main>

  <script is:inline>
    document.addEventListener("DOMContentLoaded", () => {
      const cards = document.querySelectorAll(".value-card, .team-card, .about-text, .profile-image-center, .profile-text-above, .profile-text-below, #international-presence .about-text");
      if (!("IntersectionObserver" in window)) {
        cards.forEach(card => card.classList.add("in-view"));
        return;
      }
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry, index) => {
            if (entry.isIntersecting) {
              setTimeout(() => {
                entry.target.classList.add("in-view");
              }, index * 120);
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.15, rootMargin: "0px 0px -60px 0px" }
      );
      cards.forEach(card => observer.observe(card));
    });
  </script>
</Layout>
