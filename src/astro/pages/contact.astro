---
import BaseLayout from "../layouts/BaseLayout.astro";
import { MAP_EMBED_URL, MAP_OPEN_URL } from "../data/site-config";
import "../../styles/pages/contact.css";
---

<BaseLayout
  title="Contact Us | Accountants in Paisley | Marsal Accountants"
  description="Contact Marsal Accountants in Paisley. Office at 1 Macdowall Street, PA3 2NB. Serving Glasgow and Central Scotland. Call 07468 641272 or email."
>

  <main class="contact-page">

    <section class="contact-container">
      <div class="container">
        <div class="row">

          <!-- CONTACT DETAILS -->
          <div class="col-sm-6 contact-details">

            <h1>Contact Us</h1>
            <div class="divider-content"></div>

            <p>
              <strong>Marsal Accountants</strong><br />
              Your local accountants in Paisley, supporting clients across
              Glasgow and Central Scotland.
            </p>

            <p>
              Office 1.4<br />
              1 Macdowall Street<br />
              Paisley<br />
              Scotland<br />
              PA3 2NB
            </p>

            <p>
              <strong>Telephone:</strong><br />
              <a href="tel:07468641272">07468 641272</a>
            </p>

            <p>
              <strong>Email:</strong><br />
              <a href="mailto:info@marsalaccountants.co.uk">
                info@marsalaccountants.co.uk
              </a>
            </p>

          </div>

          <!-- MAP -->
          <div class="col-sm-6 contact-map">
            <div class="map-wrapper">
              <iframe
                src={MAP_EMBED_URL}
                height="450"
                style="width:100%; border:0;"
                allowfullscreen
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
                title="Marsal Accountants office location, Paisley">
              </iframe>
              <p class="map-directions-link">
                <a href={MAP_OPEN_URL} target="_blank" rel="noopener noreferrer">
                  Get directions on Google Maps
                </a>
              </p>
            </div>
          </div>

        </div>
      </div>
    </section>

  </main>

</BaseLayout>
