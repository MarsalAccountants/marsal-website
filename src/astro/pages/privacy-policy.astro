---
import Layout from "../layouts/BaseLayout.astro";
import "../../styles/themes/tools.css";
import "../../styles/pages/articles/article-page.css";
import ContactUs from "../components/ContactUs.astro";

const theme = "resources";
const lastUpdated = "19 June 2026";
---

<Layout
  title="Privacy Policy | Marsal Accountants Paisley"
  description="Privacy policy for marsalaccountants.co.uk — how we collect, use and protect your data, including cookies and analytics."
  theme={theme}
>
  <main class="article-page container">

    <style>
      .privacy-title { color: var(--color-primary); font-weight: 800; }
      .privacy-section h2 {
        color: var(--color-primary);
        font-weight: 800;
        margin-top: 2rem;
      }
      .privacy-section a { color: var(--color-info); font-weight: 600; }
      .privacy-table {
        width: 100%;
        border-collapse: collapse;
        margin: 1rem 0;
        font-size: 0.95rem;
      }
      .privacy-table th,
      .privacy-table td {
        border: 1px solid var(--color-border-light);
        padding: 0.6rem 0.75rem;
        text-align: left;
      }
      .privacy-table th { background: var(--color-surface-lighter); }
    </style>

    <section style="margin-bottom: 2rem;">
      <h1 class="privacy-title" style="font-size: 2.4rem;">Privacy Policy</h1>
      <p style="font-size: 1.1rem; color: var(--color-text-light); margin-top: .5rem;">
        How Marsal Accountants Ltd handles your personal data when you use our website.
      </p>
      <p style="font-size: 0.95rem; color: var(--color-text-light);">Last updated: {lastUpdated}</p>
    </section>

    <section class="privacy-section" style="margin-bottom: 3rem; line-height: 1.7; font-size: 1.05rem;">

      <h2>Who we are</h2>
      <p>
        <strong>Marsal Accountants Ltd</strong> (Company No. SC848515), Office 1.4, 1 Macdowall Street, Paisley, PA3 2NB, Scotland.
        Email: <a href="mailto:info@marsalaccountants.co.uk">info@marsalaccountants.co.uk</a>.
        Phone: <a href="tel:+447468641272">07468 641272</a>.
      </p>
      <p>
        We are registered with the UK Information Commissioner’s Office (ICO) under agreement number <strong>ZC066499</strong>.
        For how we handle client accounting and tax data, see our <a href="/gdpr-compliances/">GDPR &amp; Data Protection</a> page.
      </p>

      <h2>What this policy covers</h2>
      <p>
        This policy applies to visitors of <strong>www.marsalaccountants.co.uk</strong> — for example when you browse pages,
        contact us, or use our online tools. It does not replace our client engagement terms for ongoing accountancy services.
      </p>

      <h2>Information we collect</h2>
      <ul style="margin-left: 1.2rem;">
        <li><strong>Contact details</strong> — name, email, phone, or message content if you email us, call us, or use WhatsApp.</li>
        <li><strong>Technical data</strong> — IP address, browser type, device, and pages visited (only if you accept analytics cookies).</li>
        <li><strong>Cookies</strong> — small files stored on your device (see below).</li>
      </ul>

      <h2>How we use your information</h2>
      <ul style="margin-left: 1.2rem;">
        <li>To respond to enquiries and provide our services.</li>
        <li>To run and secure our website.</li>
        <li>To understand website usage and improve content (analytics cookies only, with your consent).</li>
        <li>To meet legal and regulatory obligations.</li>
      </ul>

      <h2>Legal basis</h2>
      <p>
        We process personal data on the basis of consent (analytics cookies), legitimate interests (running and securing the website,
        responding to enquiries), and contractual necessity where you become a client.
      </p>

      <h2>Cookies we use</h2>
      <table class="privacy-table">
        <thead>
          <tr>
            <th>Cookie</th>
            <th>Purpose</th>
            <th>Duration</th>
            <th>Consent required?</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><code>marsal_market</code></td>
            <td>Remembers whether you prefer our UK or US website</td>
            <td>1 year</td>
            <td>Functional — disclosed here</td>
          </tr>
          <tr>
            <td><code>marsal_cookie_consent</code></td>
            <td>Stores your cookie choice (accept / reject)</td>
            <td>1 year</td>
            <td>Essential for consent management</td>
          </tr>
          <tr>
            <td><code>_ga</code>, <code>_ga_*</code></td>
            <td>Google Analytics — anonymous usage statistics</td>
            <td>Up to 2 years</td>
            <td>Yes — only if you click Accept</td>
          </tr>
        </tbody>
      </table>
      <p>
        You can change your choice at any time using <a href="#" data-cookie-settings>Cookie settings</a> in the footer.
        If you reject non-essential cookies, analytics will not load.
      </p>

      <h2>Third parties</h2>
      <p>
        We may use trusted providers to help run our website and practice, including Google (Analytics / Tag Manager) when you consent,
        and cloud software for client work. We do not sell your personal data.
      </p>

      <h2>How long we keep data</h2>
      <p>
        Website enquiry data is kept only as long as needed to respond and for a reasonable follow-up period.
        Client records are retained in line with HMRC and professional requirements — see our
        <a href="/gdpr-compliances/">GDPR page</a> for more detail.
      </p>

      <h2>Your rights</h2>
      <p>
        Under UK data protection law you may request access, correction, erasure, restriction, or portability of your personal data,
        and object to certain processing. Contact us at
        <a href="mailto:info@marsalaccountants.co.uk">info@marsalaccountants.co.uk</a>.
        You may also complain to the ICO at <a href="https://ico.org.uk/" target="_blank" rel="noopener noreferrer">ico.org.uk</a>.
      </p>

      <h2>Contact</h2>
      <p>
        Questions about this policy? Email
        <a href="mailto:info@marsalaccountants.co.uk">info@marsalaccountants.co.uk</a>
        or write to us at the address above.
      </p>

    </section>

    <section style="margin-top: 4rem;">
      <ContactUs />
    </section>

  </main>
</Layout>
